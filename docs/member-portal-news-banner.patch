+'use client';
+/**
+ * 📢 區會置頂消息（Pull on open + pinned display）
+ *
+ * 每次打開頁面就 fetch 一次公開 action `listAnnouncements`（pinnedOnly）：
+ * 有置頂消息就喺首頁頂部顯示，冇就自動隱藏。純粹「讀同顯示」，冇推送、冇 cache。
+ * 區管理系統（scout-district-portal /news）刪咗或下架 → 呢邊下次載入即刻消失。
+ *
+ * 想加系統通知（方案 1）？喺 useEffect 攞到 items 之後加：
+ *   const latest = items[0]?.updatedAt || '';
+ *   const seen = localStorage.getItem('news_seen') || '';
+ *   if (latest > seen && items[0]?.notify && 'Notification' in window) {
+ *     Notification.requestPermission().then(p => {
+ *       if (p === 'granted') new Notification(items[0].title, { body: items[0].body });
+ *       localStorage.setItem('news_seen', latest);
+ *     });
+ *   }
+ */
+import { useEffect, useState } from 'react';
+import { api } from '@/lib/api';
+import type { Announcement } from '@/lib/types';
+
+export default function NewsBanner() {
+  const [items, setItems] = useState<Announcement[]>([]);
+
+  useEffect(() => {
+    let live = true;
+    (async () => {
+      const result = await api.listAnnouncements(true);
+      if (!live) return;
+      // 區會後台未升級（未知的 action）→ 當冇消息，唔會影響首頁
+      if (result.ok && result.data) setItems(result.data);
+    })().catch(() => { /* 靜默：消息係附加資訊，唔應該阻住服務入口 */ });
+    return () => { live = false; };
+  }, []);
+
+  if (!items.length) return null;
+
+  return (
+    <section className="news-pins" aria-label="區會消息">
+      {items.map((news) => (
+        <article key={news.id} className={`news-pin lv-${news.level}`}>
+          <div className="news-pin-top">
+            <b>📢 {news.title}</b>
+            {news.date && <small>{news.date}</small>}
+          </div>
+          <p>{news.body}</p>
+          {news.link && (
+            <a href={news.link} target="_blank" rel="noopener noreferrer">
+              {news.linkLabel || '查看詳情'} ↗
+            </a>
+          )}
+        </article>
+      ))}
+    </section>
+  );
+}
